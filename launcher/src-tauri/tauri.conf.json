{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Renatus Launcher",
  "version": "0.1.2",
  "identifier": "fr.renatus.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Renatus",
        "width": 440,
        "height": 600,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2MUY0NTJBMTM2MDE5NTAKUldSUUdXQVRLa1VmSnBPaXVyRXhlbjNHaGdISFlFTW5lK3dwNzJZcHRBdERmTEtkZFkwMTlHa3EK",
      "endpoints": [
        "https://github.com/mmyumu/renatus_addon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
